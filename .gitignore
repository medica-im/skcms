# Vitest browser mode: screenshots and attachments written on failure only.
.vitest-attachments
__screenshots__

# Local test-runner overrides; the .example template stays tracked
# (needed because the broad `.env.*` rule above would hide it).
.env.test-all
!.env.test-all.example

# Personal working notes (review lists, scratch analysis). Untracked on
# purpose: they are a snapshot of one moment's opinion, not project
# documentation, so they would go stale in review rather than being updated.
docs/
