{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"plugins": [],
		"sourceMap": true,
		"strict": true,
		// TypeScript 6 turns this on by default: every `import '../app.postcss'`
		// (a stylesheet, resolved by Vite, with no declaration) became an error.
		"noUncheckedSideEffectImports": false
	},
	"include": ["src", "vite.config.ts", "playwright.config.ts", "tests", "./src/lib/auth.ts"]
}
